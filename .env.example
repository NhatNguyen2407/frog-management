# Browser-safe Supabase project URL and publishable key (not service-role keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staff sign-in uses Supabase email/password. No OAuth credentials are needed.

# Used only by the explicit owner bootstrap command, never by the web app.
INITIAL_OWNER_EMAIL=
INITIAL_BUSINESS_UNIT_SLUG=workshop
