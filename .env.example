# Browser-safe Supabase project URL and publishable key (not service-role keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase local Google OAuth settings. Configure hosted OAuth in its dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Used only by the explicit owner bootstrap command, never by the web app.
INITIAL_OWNER_EMAIL=
INITIAL_BUSINESS_UNIT_SLUG=workshop
